# Lets the user logged in at the machine use Lian Li UNI FAN SL V3 Wireless LCD panels (USB 1cbe:0005) without root.
# `pixdial setup` installs it in /etc/udev/rules.d (it prints the commands and runs them through sudo). On a machine
# where pixdial starts with nobody logged in at it, setup installs a group rule instead: GROUP="pixdial", MODE="0660"
# in place of TAG+="uaccess", with the user in the pixdial group.
SUBSYSTEM=="usb", ATTRS{idVendor}=="1cbe", ATTRS{idProduct}=="0005", TAG+="uaccess"
