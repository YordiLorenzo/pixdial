# Maintainer: YordiLorenzo <yordilorenzo@gmail.com>
pkgname=pixdial
pkgver=0.1.2
pkgrel=1
pkgdesc="Live hardware readings on Lian Li UNI FAN SL Wireless LCD (SL V3) fan screens"
arch=('any')
url="https://github.com/YordiLorenzo/pixdial"
license=('GPL-3.0-or-later' 'OFL-1.1')
depends=('python>=3.12' 'python-numpy' 'python-pillow' 'python-cryptography')
makedepends=('python-build' 'python-installer' 'python-hatchling' 'python-hatch-fancy-pypi-readme')
checkdepends=('python-pytest')
source=("https://files.pythonhosted.org/packages/93/2e/8c85068e9545a3b5bab98cf9373fa24d84ae4ec408e4ce3ef12c90ea9630/$pkgname-$pkgver.tar.gz")
sha256sums=('9e70fd0c21f03359d1e048f9ca58a53b1c9bf59bcc686c0451162568ef9ca719')

build() {
  cd "$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

check() {
  cd "$pkgname-$pkgver"
  # The wheel is not installed yet; make the src layout importable.
  PYTHONPATH="$PWD/src" python -m pytest
}

package() {
  cd "$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" dist/*.whl
  install -Dm644 src/pixdial/data/60-pixdial.rules "$pkgdir/usr/lib/udev/rules.d/60-pixdial.rules"
  install -Dm644 src/pixdial/data/pixdial.service "$pkgdir/usr/lib/systemd/user/pixdial.service"
  sed -i -e '/^#/d' -e 's|^ExecStart=.*|ExecStart=/usr/bin/pixdial run|' \
    -e '/^RestartPreventExitStatus=/d' -e '/^\[Service\]$/a RestartPreventExitStatus=2' \
    "$pkgdir/usr/lib/systemd/user/pixdial.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 src/pixdial/fonts/LICENSE-Lato.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE-Lato.txt"
}
